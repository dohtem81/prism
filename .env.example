APP_NAME=prism
APP_ENV=dev
APP_LOG_LEVEL=INFO

# Auth. Outside APP_ENV=dev: set a strong JWT_SECRET (the default "dev-secret" logs a startup
# warning) and note that the "dev-token" bypass is rejected.
JWT_SECRET=dev-secret
# Access token lifetime in minutes.
ACCESS_TOKEN_TTL_MINUTES=30
# Refresh tokens are single-use and rotate on every POST /v1/auth/refresh; revocation state
# lives in Redis and auth checks reject tokens if Redis is unreachable (fail closed).
REFRESH_TOKEN_TTL_DAYS=7
# Redis timeout (seconds) for token revocation checks.
TOKEN_STORE_REDIS_TIMEOUT_SECONDS=0.5
# JSON list of browser origins allowed by CORS. The default is for local dev only; production
# deployments must set this explicitly to their real origin(s).
CORS_ALLOWED_ORIGINS=["http://localhost:8000"]

API_HOST=0.0.0.0
API_PORT=8000

POSTGRES_DB=prism
POSTGRES_USER=prism
POSTGRES_PASSWORD=prism
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

RABBITMQ_USER=prism
RABBITMQ_PASSWORD=prism
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672

REDIS_HOST=redis
REDIS_PORT=6379

DATABASE_URL=postgresql+psycopg://prism:prism@postgres:5432/prism
CELERY_BROKER_URL=amqp://prism:prism@rabbitmq:5672//
CELERY_RESULT_BACKEND=redis://redis:6379/1

TRANSLATION_PROVIDER=openrouter
# Set to use this model for every room/quality mode. Leave unset (comment out) to use the
# per-quality-mode overrides below instead.
TRANSLATION_MODEL=openai/gpt-4.1-mini
TRANSLATION_FALLBACK_PROVIDER=openai
TRANSLATION_FALLBACK_MODEL=gpt-4.1-mini

# Only used when TRANSLATION_MODEL above is unset.
# TRANSLATION_MODEL_LOW_LATENCY=openai/gpt-4.1-mini
# TRANSLATION_MODEL_BALANCED=openai/gpt-4.1-mini
# TRANSLATION_MODEL_HIGH_QUALITY=anthropic/claude-3.5-sonnet

# OpenRouter: OpenAI-compatible API that routes to many underlying LLMs by model slug.
OPENROUTER_API_KEY=replace_me
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

OPENAI_API_KEY=replace_me
OPENAI_TRANSLATION_MODEL=gpt-4.1-mini
