APP_NAME=prism
APP_ENV=dev
APP_LOG_LEVEL=INFO

API_HOST=0.0.0.0
API_PORT=8000

POSTGRES_DB=prism
POSTGRES_USER=prism
POSTGRES_PASSWORD=prism
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

RABBITMQ_USER=prism
RABBITMQ_PASSWORD=prism
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672

REDIS_HOST=redis
REDIS_PORT=6379

DATABASE_URL=postgresql+psycopg://prism:prism@postgres:5432/prism
CELERY_BROKER_URL=amqp://prism:prism@rabbitmq:5672//
CELERY_RESULT_BACKEND=redis://redis:6379/1

TRANSLATION_PROVIDER=openai
TRANSLATION_MODEL=gpt-4.1-mini
TRANSLATION_FALLBACK_PROVIDER=openai
TRANSLATION_FALLBACK_MODEL=gpt-4.1-mini

OPENAI_API_KEY=replace_me
OPENAI_TRANSLATION_MODEL=gpt-4.1-mini
